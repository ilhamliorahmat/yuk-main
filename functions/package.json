{
  "name": "yuk-main-functions",
  "description": "Firebase Cloud Functions v2 Backend Game Master for Yuk Main (Spyfall Indonesia)",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync": "node -e \"const fs=require('fs');const path=require('path');const srcRoot=path.resolve(__dirname,'..','lib','games');const dstRoot=path.resolve(__dirname,'src','shared');if(fs.existsSync(srcRoot)){fs.mkdirSync(path.join(dstRoot,'spyfall'),{recursive:true});fs.copyFileSync(path.join(srcRoot,'types.ts'),path.join(dstRoot,'types.ts'));fs.copyFileSync(path.join(srcRoot,'spyfall','locations-id.ts'),path.join(dstRoot,'spyfall','locations-id.ts'));fs.copyFileSync(path.join(srcRoot,'spyfall','engine.ts'),path.join(dstRoot,'spyfall','engine.ts'));}\"",
    "build": "npm run sync && tsc",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
