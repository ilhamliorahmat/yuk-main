# Defense-in-depth: block direct HTTP access to local DB credentials and static JSON data packs
Options -Indexes

<FilesMatch "^(config\.local.*|.*\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
