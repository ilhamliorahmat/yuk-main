# Apache / InfinityFree Static Next.js + PHP API Configuration
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block direct web access to internal PHP libraries, JSON pack data, and local DB config
  RewriteRule ^api/lib/ - [F,L]
  RewriteRule ^api/config\.local(\.example)?\.php$ - [F,L]

  # Route clean /api/* REST endpoints (optional convenience alongside /api/index.php?r=...)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/(.*)$ api/index.php?r=$1 [QSA,L]

  # Serve clean Next.js static HTML routes without .html extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html
