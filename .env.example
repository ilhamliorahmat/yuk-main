# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web SDK Configuration (Project: yuk-main)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app"
# Game Master backend transport: "api" (Next.js API routes in preview) or "functions" (Firebase Cloud Functions v2 for InfinityFree static export)
NEXT_PUBLIC_GAME_MASTER_MODE="api"
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION="asia-southeast1"
# Optional subfolder path when hosted under a subdirectory (e.g. "/yukmain"); leave empty for domain root
NEXT_PUBLIC_BASE_PATH=""
