{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public player profile for Yuk Main without sensitive PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "avatarColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24
        },
        "isAnonymous": {
          "type": "boolean"
        },
        "gamesPlayed": {
          "type": "number"
        },
        "wins": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "avatarColor",
        "isAnonymous",
        "gamesPlayed",
        "wins",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomCodeLookup": {
      "title": "RoomCodeLookup",
      "description": "Maps an uppercase 6-character invite code to a roomId without exposing room lists.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gameType": {
          "type": "string",
          "enum": ["spyfall", "kata_kata", "satu_frekuensi", "fakta_hari_ini"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "roomId", "hostUid", "gameType", "createdAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Multiplayer Yuk Main room storing public state and game configuration. Never stores active secret target, word, or hidden fun fact.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "gameType": {
          "type": "string",
          "enum": ["spyfall", "kata_kata", "satu_frekuensi", "fakta_hari_ini"]
        },
        "hostUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["lobby", "playing", "voting", "spy_guess", "round_end"]
        },
        "roundNumber": {
          "type": "number"
        },
        "currentRoundId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "currentMatchRounds": {
          "type": "number",
          "description": "Completed rounds in the current game visit; 0 guards accidental game switches from recording empty matches."
        },
        "completedGames": {
          "type": "array",
          "description": "Chronological isolated per-game match results and point breakdowns for Rekap Permainan (max 25)."
        },
        "activeRecap": {
          "type": "object",
          "description": "Synchronized Rekap Permainan overlay state including win-count MVP, standings, and optional Best-of-3 Suit Duel tiebreaker."
        },
        "lastEmptyAtMs": {
          "type": "number",
          "description": "Timestamp (ms) when the last real player left; triggers auto-reset on re-entry after 15 seconds."
        },
        "roundDurationSec": {
          "type": "number"
        },
        "roundEndsAtMs": {
          "type": "number"
        },
        "firstSpeakerUid": {
          "type": "string",
          "maxLength": 128
        },
        "spyMode": {
          "type": "string",
          "enum": ["single", "double", "random"]
        },
        "enabledPacks": {
          "type": "array",
          "description": "Active built-in content pack IDs (max 10)."
        },
        "selectedLocationNames": {
          "type": "array",
          "description": "Public pool of possible locations for the active Spyfall round (max 40)."
        },
        "customLocations": {
          "type": "array",
          "description": "Host-defined custom locations and role pools for Yang Bener Yang Mana (max 20)."
        },
        "customWordPairs": {
          "type": "array",
          "description": "Host-defined custom word pairs for Kata-Kata Hari Ini (max 30)."
        },
        "customSpectrums": {
          "type": "array",
          "description": "Host-defined custom left/right spectrum pairs for Satu Frekuensi (max 25)."
        },
        "customFacts": {
          "type": "array",
          "description": "Host-defined custom parenthetical fun facts for Fakta Hari Ini (max 30)."
        },
        "eliminatedUids": {
          "type": "array",
          "description": "List of eliminated player UIDs during an active Kata-Kata Hari Ini round."
        },
        "eliminationLog": {
          "type": "array",
          "description": "Public elimination timeline revealing whether eliminated players were Warga or Penyusup."
        },
        "frequencyState": {
          "type": "object",
          "description": "Public state for Satu Frekuensi (spectrum labels, psychicUid, clueText, lockedUids, reveal summary)."
        },
        "faktaState": {
          "type": "object",
          "description": "Public state for Fakta Hari Ini (ordered guesserUid, phaseControllerUid, phase, pick & post-round reveal)."
        },
        "activeVote": {
          "type": "object",
          "description": "Current accusation vote state when status is voting or spy_guess."
        },
        "pendingSpyGuess": {
          "type": "object",
          "description": "Submitted location/word guess from a Spy."
        },
        "lastRoundResult": {
          "type": "object",
          "description": "Revealed outcome of the most recently completed round."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "code",
        "gameType",
        "hostUid",
        "status",
        "roundNumber",
        "currentRoundId",
        "roundDurationSec",
        "roundEndsAtMs",
        "firstSpeakerUid",
        "spyMode",
        "enabledPacks",
        "selectedLocationNames",
        "customLocations",
        "activeVote",
        "pendingSpyGuess",
        "lastRoundResult",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomPlayer": {
      "title": "RoomPlayer",
      "description": "Player membership and cumulative score inside a Yuk Main room.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "avatarColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24
        },
        "isHost": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        },
        "isReady": {
          "type": "boolean"
        },
        "controllerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the physical device controlling this seat (equals uid for normal players, host device uid for Numpang seats)."
        },
        "isNumpang": {
          "type": "boolean",
          "description": "True when this seat shares another player's phone via selective Numpang protocol."
        },
        "isBrb": {
          "type": "boolean",
          "description": "True when the player is temporarily stepped away (excluded from new rounds/votes without being kicked)."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "roomId",
        "displayName",
        "avatarColor",
        "isHost",
        "score",
        "isReady",
        "joinedAt",
        "updatedAt"
      ]
    },
    "PlayerSecret": {
      "title": "PlayerSecret",
      "description": "Strictly private per-player secret role, target, word, or fact card for a single round.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roundId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gameType": {
          "type": "string",
          "enum": ["spyfall", "kata_kata", "satu_frekuensi", "fakta_hari_ini"]
        },
        "isSpy": {
          "type": "boolean"
        },
        "locationName": {
          "type": "string",
          "maxLength": 80
        },
        "roleName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "secretWord": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "isPsychic": {
          "type": "boolean"
        },
        "targetValue": {
          "type": "number"
        },
        "isGuesser": {
          "type": "boolean"
        },
        "isTruthTeller": {
          "type": "boolean"
        },
        "truthTellerUid": {
          "type": "string",
          "maxLength": 128
        },
        "truthTellerName": {
          "type": "string",
          "maxLength": 40
        },
        "factPrefix": {
          "type": "string",
          "maxLength": 240
        },
        "factTwist": {
          "type": "string",
          "maxLength": 240
        },
        "factSuffix": {
          "type": "string",
          "maxLength": 140
        },
        "factCategory": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "roundId", "gameType", "createdAt"]
    },
    "PlayerSubmission": {
      "title": "PlayerSubmission",
      "description": "Isolated per-player hidden submission for Satu Frekuensi dial values or Rekap Permainan Best-of-3 Suit Duel picks.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roundId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gameType": {
          "type": "string",
          "enum": ["satu_frekuensi", "suit_duel"]
        },
        "guessValue": {
          "type": "number"
        },
        "suitPick": {
          "type": "string",
          "enum": ["batu", "gunting", "kertas"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "roundId", "gameType", "updatedAt"]
    },
    "ServerRoundState": {
      "title": "ServerRoundState",
      "description": "Round truth document read strictly inside resolution transactions.",
      "type": "object",
      "properties": {
        "roundId": {
          "type": "string",
          "maxLength": 64
        },
        "roundNumber": {
          "type": "number"
        },
        "locationName": {
          "type": "string",
          "maxLength": 80
        },
        "citizenWord": {
          "type": "string",
          "maxLength": 60
        },
        "spyWord": {
          "type": "string",
          "maxLength": 60
        },
        "spyUids": {
          "type": "array"
        },
        "spyNames": {
          "type": "array"
        },
        "targetValue": {
          "type": "number"
        },
        "factPrefix": {
          "type": "string",
          "maxLength": 240
        },
        "factTwist": {
          "type": "string",
          "maxLength": 240
        },
        "factSuffix": {
          "type": "string",
          "maxLength": 140
        },
        "factCategory": {
          "type": "string",
          "maxLength": 40
        },
        "truthTellerUid": {
          "type": "string",
          "maxLength": 128
        },
        "truthTellerName": {
          "type": "string",
          "maxLength": 40
        },
        "createdAtMs": {
          "type": "number"
        }
      },
      "required": ["roundId", "roundNumber", "locationName", "spyUids", "spyNames", "createdAtMs"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public player profiles keyed by Firebase Auth UID."
    },
    "/roomCodes/{code}": {
      "schema": { "$ref": "#/entities/RoomCodeLookup" },
      "description": "Invite code lookup documents (get by exact 6-char code only, no list)."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Shared Yuk Main multiplayer rooms."
    },
    "/rooms/{roomId}/players/{playerId}": {
      "schema": { "$ref": "#/entities/RoomPlayer" },
      "description": "Players participating in a specific room."
    },
    "/rooms/{roomId}/rounds/{roundId}/secrets/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerSecret" },
      "description": "Isolated per-player secret card readable only by the owning playerId until round_end."
    },
    "/rooms/{roomId}/rounds/{roundId}/submissions/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerSubmission" },
      "description": "Isolated per-player dial submission for Satu Frekuensi."
    },
    "/rooms/{roomId}/serverState/{stateId}": {
      "schema": { "$ref": "#/entities/ServerRoundState" },
      "description": "Round secret truth document resolved atomically in Firestore transactions."
    }
  }
}
